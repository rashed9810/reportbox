# Copy this file to .env and fill in the values.

# SQLite for trying it out; Postgres (see docker-compose.yml) for anything real.
DATABASE_URL=sqlite:///./reportbox.db
# DATABASE_URL=postgresql+psycopg://reportbox:reportbox@localhost:5432/reportbox

# Long random strings. Generate the encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me-to-a-long-random-string
FILE_ENCRYPTION_KEY=

STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=

# console = print SMS in the terminal. bulksmsbd = real SMS through BulkSMSBD.
# http = another aggregator (edit app/messaging.py to match its API).
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HTTP_URL=
SMS_HTTP_API_KEY=

# WhatsApp. With WHATSAPP_ENABLED=true and no WA_PHONE_NUMBER_ID, messages are printed in the
# terminal instead of sent, so you can try the flow locally.
WHATSAPP_ENABLED=false
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Billing
VAT_PERCENT=0
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=
