# Copy to .env in this folder and fill in every value. Never commit or share the real .env.

# Your domain, already pointing (DNS A record) at this server's IP
DOMAIN=reportbox.example.com.bd

# Long random values. Make each with:  openssl rand -base64 32
POSTGRES_PASSWORD=
SECRET_KEY=
BACKUP_PASSPHRASE=

# Encrypts report PDFs. Make with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A COPY OFFLINE (e.g. printed in a safe). Without it, no backup of the reports can be read.
FILE_ENCRYPTION_KEY=

# SMS: console (prints only, for testing) or bulksmsbd
SMS_PROVIDER=console
SMS_API_KEY=
# Default sender ID for login codes (labs use their own registered sender ID)
SMS_SENDER_ID=

# WhatsApp (optional; see docs/DEPLOY.md step 8). Leave false until the template is approved.
WHATSAPP_ENABLED=false
WA_API_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# From the Meta app's Basic settings; checks delivery updates really come from Meta
WA_APP_SECRET=
# Any random text (openssl rand -hex 16); type the same in Meta's webhook settings
WA_VERIFY_TOKEN=
WA_TEMPLATE_REPORT_READY=report_ready

# Billing. Confirm the VAT rate (and any startup exemption) with an accountant before charging VAT.
VAT_PERCENT=0
# Where labs send payments (shown on their Billing page)
PAYMENT_BKASH_NUMBER=
PAYMENT_NAGAD_NUMBER=

BACKUP_KEEP_DAYS=14
